# Application Settings
APP_NAME=EcoCampus Backend
DEBUG=True
VERSION=1.0.0

# Database (SQLite for local development)
DATABASE_URL=sqlite:///./ecocampus.db
DATABASE_URL_TEST=sqlite:///./ecocampus_test.db

# JWT Settings
SECRET_KEY=your-super-secret-key-change-this-in-production-with-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Keys (Optional)
OPENWEATHER_API_KEY=
CLIMATIQ_API_KEY=
ELECTRICITYMAP_API_KEY=

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000","http://127.0.0.1:8080"]

# Redis
REDIS_URL=redis://localhost:6379/0

# MQTT Broker
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=campus/iot/#
